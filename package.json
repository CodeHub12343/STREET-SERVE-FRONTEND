{
  "name": "streetserve-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "StreetServe frontend — Next.js App Router + React 18 + TypeScript PWA (Milestone 0: Foundation)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "predev": "node scripts/clean-sw.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install chromium webkit",
    "budgets": "node scripts/check-bundle-budgets.mjs",
    "check:pwa": "node scripts/check-pwa.mjs",
    "lhci": "lhci autorun",
    "verify": "npm run typecheck && npm run lint && npm run reachability && npm run audit:deps && npm run test && npm run build && npm run budgets && npm run check:pwa",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "reachability": "node scripts/check-reachability.mjs",
    "audit:deps": "node scripts/check-vulnerabilities.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^5.7.5",
    "@stripe/react-stripe-js": "^2.8.1",
    "@stripe/stripe-js": "^4.9.0",
    "@tanstack/react-query": "^5.59.15",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.454.0",
    "mapbox-gl": "^3.7.0",
    "motion": "^12.42.2",
    "next": "14.2.35",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "socket.io-client": "^4.7.5",
    "styled-components": "^6.1.13",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "overrides": {
    "webpack": "5.94.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.48.0",
    "@serwist/next": "^9.0.9",
    "@storybook/addon-essentials": "^8.3.6",
    "@storybook/addon-themes": "^8.3.6",
    "@storybook/blocks": "^8.3.6",
    "@storybook/nextjs": "^8.3.6",
    "@storybook/react": "^8.3.6",
    "@testing-library/jest-dom": "^6.6.2",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/geojson": "^7946.0.16",
    "@types/mapbox-gl": "^3.4.0",
    "@types/node": "^20.14.14",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.2",
    "axe-core": "^4.10.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.15",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-storybook": "^0.9.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "serwist": "^9.0.9",
    "storybook": "^8.3.6",
    "typescript": "^5.5.4",
    "vitest": "^2.1.3",
    "vitest-axe": "^0.1.0"
  }
}
