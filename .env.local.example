# StreetServe frontend — environment
# Copy to `.env.local` and fill in. Only NEXT_PUBLIC_* reaches the browser; never put
# a secret here (AUTHENTICATION_IMPLEMENTATION.md §9).

# --- Backend (the standalone Express API + Socket.IO server) ---
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:8080

# --- Clerk (managed auth) ---
# Leave blank to boot the shell without auth (dev). Set both to activate sign-in + guards.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# --- Stripe (publishable key only; PaymentIntents are created by the backend) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Mapbox (URL-restricted public token) ---
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- PWA (Serwist). Enable in Milestone 9. ---
ENABLE_PWA=false

# --- Landing page state ---
# `prelaunch` shows the waitlist/registration landing; `live` shows the real app entry.
NEXT_PUBLIC_LAUNCH_STATE=prelaunch

# --- Map demo mode ---
# `true` renders the map from fixtures instead of the live API. Never true in a deployed env.
NEXT_PUBLIC_MAP_DEMO=false
